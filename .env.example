# Chiave API Google AI (Gemini)
# Ottienila da: https://aistudio.google.com/apikey
VITE_GOOGLE_AI_API_KEY=la_tua_chiave_qui

# Opzionale: NASA APOD
# VITE_NASA_API_KEY=your_nasa_key

# Netlify Functions (server-side, non esposto al browser)
# GOOGLE_AI_API_KEY=your_gemini_key
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Opzionale: renderer WebGPU sperimentale (post-processing disabilitato)
# VITE_EXPERIMENTAL_WEBGPU=true
